{
  "manifest_version": 3, 
  "name": "Sales Call AI", 
  "version": "1.1",
  "description": "Real-time sales call assistant", 

  
  "permissions": [
    "storage", 
    "tabCapture", 
    "offscreen",
    "alarms", 
    "activeTab",
    "downloads"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Click to start recording this Meet call"
  },

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"], 
      "js": ["content.js"]
    }
  ]
}

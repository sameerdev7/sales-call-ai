{
  "manifest_version": 3, 
  "name": "Sales Call AI", 
  "version": "1.0",
  "description": "Real-time sales call assistant", 

  
  "permissions": [
    "storage", 
    "tabCapture", 
    "offscreen"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"], 
      "js": ["content.js"]
    }
  ]
}
